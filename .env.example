# Default rules mode works for teammates without an API key.
SCOPESHIFT_AI_MODE=rules
# Set openai mode only on the backend server. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=20000
# Required in OpenAI mode: a persistent random secret of at least 32 characters.
SCOPESHIFT_SESSION_SECRET=
# Optional: defaults to .scopeshift/replay on a persistent local filesystem.
SCOPESHIFT_REPLAY_DIR=
